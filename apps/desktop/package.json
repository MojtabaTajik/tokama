{
  "name": "@tokama/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "tsc --build ../../tsconfig.json && install-electron && electron-vite dev",
    "dev:sample": "tsc --build ../../tsconfig.json && install-electron && TOKAMA_SAMPLE=1 electron-vite dev",
    "build": "electron-vite build && node -e \"for (const f of ['dist/main/index.js', 'dist/preload/index.cjs', 'dist/renderer/index.html']) require('fs').accessSync(f)\"",
    "e2e": "install-electron && vitest run --config e2e/vitest.config.ts",
    "icons": "node scripts/make-icons.ts",
    "sounds": "node scripts/make-sounds.ts",
    "package": "install-electron && node scripts/package.ts",
    "package:dmg": "install-electron && node scripts/package.ts --dmg",
    "sound-check": "node scripts/sound-check.ts",
    "verify": "node scripts/verify-package.ts",
    "smoke": "node scripts/smoke-installed.ts"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@resvg/resvg-js": "2.6.2",
    "@tokama/client": "workspace:*",
    "@tokama/core": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.1",
    "electron-updater": "6.8.12",
    "electron-vite": "6.0.0",
    "lucide-react": "1.81.0",
    "playwright-core": "1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.8"
  }
}
