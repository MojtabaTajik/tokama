{
  "name": "@tokama/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "tsc --build ../../tsconfig.json && install-electron && electron-vite dev",
    "build": "electron-vite build && node -e \"for (const f of ['dist/main/index.js', 'dist/preload/index.cjs', 'dist/renderer/index.html']) require('fs').accessSync(f)\"",
    "smoke": "install-electron && node scripts/smoke.ts"
  },
  "devDependencies": {
    "@tokama/client": "workspace:*",
    "@tokama/core": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.4.1",
    "electron-vite": "6.0.0",
    "playwright-core": "1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.8"
  }
}
