{
  "name": "tokama",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter @tokama/desktop dev",
    "dev:sample": "pnpm --filter @tokama/desktop dev:sample",
    "build": "tsc --build && pnpm --filter @tokama/desktop build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build && pnpm --recursive exec tsc --project tsconfig.test.json && tsc --project tooling/tsconfig.json && tsc --project tooling/removal-test",
    "lint": "eslint -c eslint.config.js .",
    "test": "vitest run --config tooling/vitest.config.ts --project fast",
    "test:int": "vitest run --config tooling/vitest.config.ts --project int",
    "test:all": "vitest run --config tooling/vitest.config.ts",
    "removal-test": "tsc --project tooling/removal-test && node tooling/removal-test/removal-test.ts",
    "package": "pnpm build && pnpm --filter @tokama/desktop package",
    "package:dmg": "pnpm build && pnpm --filter @tokama/desktop package:dmg",
    "e2e:real": "pnpm build && pnpm --filter @tokama/e2e real"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "eslint": "10.15.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.4",
    "happy-dom": "21.0.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
